# Kopiér denne fil til terraform.tfvars og udfyld dine egne værdier.
# terraform.tfvars bliver IKKE committet til git (se .gitignore).

subscription_id     = "451d0fc1-6bbb-433c-98bf-05a95d5586fb"
prefix               = "lamp"
location             = "westeurope"
vm_size              = "Standard_B1s"
admin_username       = ""
ssh_public_key_path  = "~/.ssh/terra.pub"
admin_source_ip      = "185.73.72.112/32"
db_root_password     = ""
discord_webhook_url  = ""

# Ekstra Linux/SSH-brugere på VM'en (valgfrit, kan udelades / stå tom)
additional_users = [
  {
    username            = "usr"
    ssh_public_key_path = "~/.ssh/usr.pub"
    sudo                = true
  },
  {
    username            = "usr2"
    ssh_public_key_path = "~/.ssh/usr2.pub"
    sudo                = false
  }
]

# Read-only MariaDB-bruger til dashboard
dashboard_db_username = ""
dashboard_db_password = ""
dashboard_db_host     = "localhost"

# GeoIP-kort over adgangsforsøg (SSH + Suricata) - kræver en gratis
# MaxMind-konto, se README.md
maxmind_account_id  = ""
maxmind_license_key = ""
geoip_db_password   = ""
