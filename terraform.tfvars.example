# Kopiér denne fil til terraform.tfvars og udfyld dine egne værdier.
# terraform.tfvars bliver IKKE committet til git (se .gitignore).

subscription_id     = "451d0fc1-6bbb-433c-98bf-05a95d5586fb"
prefix               = "lamp"
location             = "westeurope"
vm_size              = "Standard_B1s"
admin_username       = ""
ssh_public_key_path  = "~/.ssh/terra.pub"
admin_source_ip      = "185.73.72.112/32"
extra_admin_source_ips = []   # fx ["x.x.x.x/32", "y.y.y.y/32"] - hjemmeadresser
db_root_password     = ""
discord_webhook_url  = ""

# Ekstra Linux/SSH-brugere på VM'en (valgfrit, kan udelades / stå tom)
additional_users = [
  {
    username            = "usr"
    ssh_public_key_path = "~/.ssh/usr.pub"
    sudo                = true
  },
  {
    username            = "usr2"
    ssh_public_key_path = "~/.ssh/usr2.pub"
    sudo                = false
  }
]

# Read-only MariaDB-bruger til dashboard
dashboard_db_username = ""
dashboard_db_password = ""
dashboard_db_host     = "localhost"

# GeoIP-kort over adgangsforsøg (SSH + Suricata) - kræver en gratis
# MaxMind-konto, se README.md
maxmind_account_id  = ""
maxmind_license_key = ""
geoip_db_password   = ""

# Grafana admin-login (i stedet for default admin/admin)
grafana_admin_user     = "admin"
grafana_admin_password = ""

# MQTT-broker (Mosquitto, TLS paa 8883) til IoT-device
mqtt_username       = "iot_device"
mqtt_password       = ""
mqtt_allowed_source = ""   # tom = admin_source_ip; saet til devicens IP (x.x.x.x/32) naar den er kendt
dns_label           = ""   # valgfrit, globalt unikt Azure DNS-label (anbefalet, saa certifikatet overlever IP-skift)

# Adgangskontrol-database (database.tf)
access_db_password = ""
# ssh_private_key_path = ""   # tom = ssh-agent; kun en sti hvis noeglen IKKE har passphrase

# Adgangs-service (access_service.tf) - egen MQTT-bruger paa VM'en, min. 12 tegn
access_service_mqtt_password = ""

# Admin-panel (webadmin.tf) - https://<ip>:8443
customer_admin_ips      = []          # kundens IT-team, fx ["203.0.113.10/32"]; vores admin-IP'er har altid adgang
webadmin_admin_username = "it-admin"
webadmin_admin_password = ""          # min. 12 tegn, ingen ' " eller \
webadmin_site_name      = "Filial"    # vises i bunden af panelet

# Discord-besked med IP naar serveren er oppe (notify.tf) - tom = slaaet fra
discord_deploy_webhook_url = ""
