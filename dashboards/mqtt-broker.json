      "options": { "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus-ds" }, "expr": "mqtt_uptime_seconds", "refId": "A" }
      ],
      "title": "Broker uptime",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "NED", "color": "red" }, "1": { "text": "OK", "color": "green" } } }
          ],
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus-ds" }, "expr": "up{job=\"mqtt_broker\"} * mqtt_exporter_connected", "refId": "A" }
      ],
      "title": "Exporter + broker status",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "id": 5,
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus-ds" }, "expr": "rate(mqtt_messages_received_total[1m])", "legendFormat": "modtaget", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus-ds" }, "expr": "rate(mqtt_messages_sent_total[1m])", "legendFormat": "sendt", "refId": "B" }
      ],
      "title": "Beskeder pr. sekund",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "id": 6,
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus-ds" }, "expr": "rate(mqtt_bytes_received_total[1m])", "legendFormat": "modtaget", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus-ds" }, "expr": "rate(mqtt_bytes_sent_total[1m])", "legendFormat": "sendt", "refId": "B" }
      ],
      "title": "Bytes pr. sekund",
      "type": "timeseries"
    }
